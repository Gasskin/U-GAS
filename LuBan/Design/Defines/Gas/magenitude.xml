<module name="Gas">
    <!-- 基类 -->
    <bean name="BaseMagnitude">
    </bean>

    <bean name="Modifier">
        <var name="target_attr" type="EAttributeId"/>
        <var name="operate" type="EModifierOperation"/>
        <var name="magnitude" type="BaseMagnitude"/>
    </bean>

    <!-- y = b -->
    <bean name="FloatMagnitude" parent="BaseMagnitude">
        <var name="float_b" type="float"/>
    </bean>

    <!-- y = attr_base * (1 + attr_k) + attr_b -->
    <bean name="RelativeAttrMagnitude" parent="BaseMagnitude">
        <var name="relative_attr_base" type="EAttributeId"/>
        <var name="relative_attr_k" type="EAttributeId"/>
        <var name="relative_attr_b" type="EAttributeId"/>
    </bean>
</module>